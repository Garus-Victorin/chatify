# --- Database (PostgreSQL — Neon, Supabase, etc.) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth secret (JWT signing — generate with: openssl rand -base64 32) ---
AUTH_SECRET="your-secret-key-min-32-chars"

# --- Puter.js (chat IA côté client, keyless) ---
# Le chat principal utilise Puter.js directement dans le navigateur (via CDN).
# Aucune clé n'"'"'est requise pour le chat. Les utilisateurs paient leur propre usage (User-Pays).
# Token OPTIONNEL ci-dessous : requis uniquement pour l'"'"'agent ReAct et les plugins
# Code Interpreter / PDF côté serveur (sinon ces features se dégradent proprement).
PUTER_AUTH_TOKEN=""

# Modèles Puter (optionnel, defaults: gpt-5-nano)
PUTER_CHAT_MODEL="gpt-5-nano"
PUTER_REASON_MODEL="gpt-5-nano"

# --- Embeddings (OBLIGATOIRE pour la mémoire vectorielle RAG) ---
# OpenAI est le seul fournisseur d'"'"'embeddings utilisé (Groq n'"'"'a pas d'"'"'équivalent Puter).
OPENAI_API_KEY="sk-..."

# --- Tavily API (web search, conservé tel quel) ---
TAVILY_API_KEY="tvly-..."

# --- Optionnel (existait déjà) ---
VECTOR_SIMILARITY_THRESHOLD=0.72
VECTOR_MAX_RESULTS=5
