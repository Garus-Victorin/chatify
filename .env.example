# --- Database (PostgreSQL — Neon, Supabase, etc.) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth secret (JWT signing — generate with: openssl rand -base64 32) ---
AUTH_SECRET="your-secret-key-min-32-chars"

# --- Kilo AI Gateway (chat + agent + plugins) ---
# OpenAI-compatible gateway. Free models work without a key (rate-limited by IP).
# Set KILO_API_KEY to use paid models or raise rate limits.
KILO_BASE_URL="https://ai-gateway.kilo.ai/api/v1"
KILO_API_KEY=""
NEXT_PUBLIC_KILO_BASE_URL="https://ai-gateway.kilo.ai/api/v1"
NEXT_PUBLIC_KILO_API_KEY=""
NEXT_PUBLIC_KILO_CHAT_MODEL="kilo-auto/free"

# Server-side model for agent/plugins/summarization
KILO_SERVER_MODEL="kilo-auto/free"

# --- Embeddings (optionnel — fallback hash si absent) ---
# OpenAI embeddings (text-embedding-3-small). If unset, a deterministic hash
# fallback is used (development only).
OPENAI_API_KEY=""

# --- Tavily API (web search) ---
TAVILY_API_KEY="tvly-..."

# --- Optionnel ---
VECTOR_SIMILARITY_THRESHOLD=0.72
VECTOR_MAX_RESULTS=5
NODE_ENV="development"


